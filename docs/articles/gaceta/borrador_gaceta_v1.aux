\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Método de Halley para $z^3-1$ en las dos cartas de $\mathbb  {P}^1(\mathbb  {C})$. Las cuencas son más regulares que en Newton y la frontera fractal es más suave.\relax }}{9}{figure.caption.6}\protected@file@percent }
\newlabel{fig:halley}{{6}{9}{Método de Halley para $z^3-1$ en las dos cartas de $\Puno $. Las cuencas son más regulares que en Newton y la frontera fractal es más suave.\relax }{figure.caption.6}{}}
