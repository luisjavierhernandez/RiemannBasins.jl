\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Cuencas del 2-ciclo $\{0,-1\}$ para $f(z)=z^2-1$, generadas con \texttt  {basin\_portrait\_pcycle}. La zona negra de la figura\nobreakspace  {}\ref  {fig:basins_z2m1} aparece ahora coloreada como cuenca del ciclo; la frontera fractal refleja la simetría $z\DOTSB \mapstochar \rightarrow -z$ de\nobreakspace  {}$f$.\relax }}{11}{figure.caption.8}\protected@file@percent }
\newlabel{fig:pcycle_z2}{{8}{11}{Cuencas del 2-ciclo $\{0,-1\}$ para $f(z)=z^2-1$, generadas con \fn {basin\_portrait\_pcycle}. La zona negra de la figura~\ref {fig:basins_z2m1} aparece ahora coloreada como cuenca del ciclo; la frontera fractal refleja la simetría $z\mapsto -z$ de~$f$.\relax }{figure.caption.8}{}}
