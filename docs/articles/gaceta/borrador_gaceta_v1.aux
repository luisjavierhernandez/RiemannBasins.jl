\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Retrato de cuencas de $f(z)=z^2-1$ generado con \texttt  {basin\_portrait}. La región coloreada es la cuenca del punto fijo en $\infty $. La zona negra no indica divergencia: corresponde a puntos cuya órbita converge al 2-ciclo $\{0,-1\}$, invisible para un algoritmo que solo busca puntos fijos.\relax }}{10}{figure.caption.7}\protected@file@percent }
\newlabel{fig:basins_z2m1}{{7}{10}{Retrato de cuencas de $f(z)=z^2-1$ generado con \fn {basin\_portrait}. La región coloreada es la cuenca del punto fijo en $\infty $. La zona negra no indica divergencia: corresponde a puntos cuya órbita converge al 2-ciclo $\{0,-1\}$, invisible para un algoritmo que solo busca puntos fijos.\relax }{figure.caption.7}{}}
