\newlabel{fig:newton_z4}{{3}{7}{Newton para $z^4-1$ en las dos cartas de $\Puno $ (carta~1 a la izquierda, carta~2 a la derecha). En la segunda carta se aprecia la cuenca que rodea el punto en el infinito (repulsor), oculta en la representaci\'{o}n plana habitual. Generado con el paquete \pkg {RiemannBasins.jl}.\relax }{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Método de Halley para $z^3-1$ en las dos cartas de $\mathbb  {P}^1(\mathbb  {C})$. Las cuencas son más regulares que en Newton y la frontera fractal es más suave.\relax }}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:halley}{{4}{7}{Método de Halley para $z^3-1$ en las dos cartas de $\Puno $. Las cuencas son más regulares que en Newton y la frontera fractal es más suave.\relax }{figure.caption.4}{}}
