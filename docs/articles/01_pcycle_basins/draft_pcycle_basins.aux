\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Basin portrait of the period-5 centre $f_c(z)=z^2+c$ ($c\approx -0.5043+0.5628i$, superattracting 5-cycle) with the \texttt  {pcycle\_lch} colour strategy (\texttt  {hue\_band}$=150^\circ $, hue step $30^\circ $ per sub-basin). The five sub-basins $B_0,\ldots  ,B_4$ are encoded by increasing hue within the same perceptual family; the five-fold near-symmetry of the Julia set and the cyclic permutation $f\nobreak  \mskip 2mu\mathpunct {}\nonscript \mkern -\thinmuskip {:}\mskip 6muplus1mu\relax B_0\to B_1\to \cdots  \to B_4\to B_0$ are readable directly from the colour progression. The circular colour-wheel inset (top right) shows the five sub-basin hues in their cyclic order.}}{25}{figure.9}\protected@file@percent }
\newlabel{fig:period5_lch}{{9}{25}{Basin portrait of the period-5 centre $f_c(z)=z^2+c$ ($c\approx -0.5043+0.5628i$, superattracting 5-cycle) with the \texttt {pcycle\_lch} colour strategy (\texttt {hue\_band}$=150^\circ $, hue step $30^\circ $ per sub-basin). The five sub-basins $B_0,\ldots ,B_4$ are encoded by increasing hue within the same perceptual family; the five-fold near-symmetry of the Julia set and the cyclic permutation $f\colon B_0\to B_1\to \cdots \to B_4\to B_0$ are readable directly from the colour progression. The circular colour-wheel inset (top right) shows the five sub-basin hues in their cyclic order}{figure.9}{}}
