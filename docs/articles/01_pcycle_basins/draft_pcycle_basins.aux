\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Basin portrait of the Douady rabbit $f_c(z)=z^2+c$ ($c\approx -0.1226+0.7449i$, the complex root with positive imaginary part of $c^3+2c^2+c+1=0$) rendered with the \texttt  {pcycle\_lch} colour strategy (\texttt  {hue\_band}$=120^\circ $). The three sub-basins $B_0$, $B_{c_{\mathrm  {r}}}$, $B_{c_{\mathrm  {r}}^2+c_{\mathrm  {r}}}$ are separated by hue offsets of $40^\circ $; grey is the basin of\nobreakspace  {}$\infty $. Compared with the airplane (Figure\nobreakspace  {}\ref  {fig:airplane_pcycle}), the sub-basins are large and round, making the cyclic permutation $f\nobreak  \mskip 2mu\mathpunct {}\nonscript \mkern -\thinmuskip {:}\mskip 6muplus1mu\relax B_0\to B_{c_{\mathrm  {r}}}\to B_{c_{\mathrm  {r}}^2+c_{\mathrm  {r}}}\to B_0$ directly readable from the colours.}}{23}{figure.8}\protected@file@percent }
\newlabel{fig:rabbit_pcycle_lch}{{8}{23}{Basin portrait of the Douady rabbit $f_c(z)=z^2+c$ ($c\approx -0.1226+0.7449i$, the complex root with positive imaginary part of $c^3+2c^2+c+1=0$) rendered with the \texttt {pcycle\_lch} colour strategy (\texttt {hue\_band}$=120^\circ $). The three sub-basins $B_0$, $B_{c_{\mathrm {r}}}$, $B_{c_{\mathrm {r}}^2+c_{\mathrm {r}}}$ are separated by hue offsets of $40^\circ $; grey is the basin of~$\infty $. Compared with the airplane (Figure~\ref {fig:airplane_pcycle}), the sub-basins are large and round, making the cyclic permutation $f\colon B_0\to B_{c_{\mathrm {r}}}\to B_{c_{\mathrm {r}}^2+c_{\mathrm {r}}}\to B_0$ directly readable from the colours}{figure.8}{}}
