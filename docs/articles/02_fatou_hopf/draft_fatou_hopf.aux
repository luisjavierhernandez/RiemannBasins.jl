\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Basin portrait of $f(z)=z^2-\genfrac  {}{}{}1{3}{4}$ on $[-1.8,1.8]\times [-1.0,1.0]$ ($600$ iterations, $b=e$, $10$ bands). \textit  {Black interior}: the parabolic basin $B^{\mathrm  {par}}_f(z^*)$ of the fixed point $z^*=-\genfrac  {}{}{}1{1}{2}$ with multiplier $-1$; orbits converge to $z^*$ at the logarithmic rate $(\qopname  \relax o{log}N)/N$ (see\nobreakspace  {}\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:parabolic_rate}\unskip \@@italiccorr )}}), too slowly to be detected as attracting within $600$ steps. \textit  {Coloured exterior}: basin of $\infty $, graded by escape speed (lighter\nobreakspace  {}$=$\nobreakspace  {}faster escape). White $\bigstar $: the parabolic fixed point $z^*=-\genfrac  {}{}{}1{1}{2}$; the self-loop arrow indicates $f(z^*)=z^*$.}}{11}{figure.1}\protected@file@percent }
\newlabel{fig:cycle_parabolic_p2}{{1}{11}{Basin portrait of $f(z)=z^2-\tfrac {3}{4}$ on $[-1.8,1.8]\times [-1.0,1.0]$ ($600$ iterations, $b=e$, $10$ bands). \textit {Black interior}: the parabolic basin $B^{\mathrm {par}}_f(z^*)$ of the fixed point $z^*=-\tfrac {1}{2}$ with multiplier $-1$; orbits converge to $z^*$ at the logarithmic rate $(\log N)/N$ (see~\eqref {eq:parabolic_rate}), too slowly to be detected as attracting within $600$ steps. \textit {Coloured exterior}: basin of $\infty $, graded by escape speed (lighter~$=$~faster escape). White $\bigstar $: the parabolic fixed point $z^*=-\tfrac {1}{2}$; the self-loop arrow indicates $f(z^*)=z^*$}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Basin portrait of $f(z)=z^2-\genfrac  {}{}{}1{5}{4}$ on $[-1.8,1.8]\times [-0.8,0.8]$ ($600$ iterations). The parabolic 2-cycle $\{z_1\approx 0.207,\,z_2\approx -1.207\}$ has multiplier $(f^2)'(z_1)=-1$. \textit  {Black interior}: the parabolic basin; orbits converge to $\{z_1,z_2\}$ at the logarithmic rate $(\qopname  \relax o{log}N)/N$. \textit  {Coloured exterior}: basin of $\infty $. White circles $\bullet $: cycle points $z_1$ (right) and $z_2$ (left). Semicircular arcs show the cyclic order: $z_1\xrightarrow {f}z_2$ (upper arc) and $z_2\xrightarrow {f}z_1$ (lower arc); arc radius $|z_1-z_2|/2=\sqrt  {2}/2$.}}{12}{figure.2}\protected@file@percent }
\newlabel{fig:cycle_parabolic_p4}{{2}{12}{Basin portrait of $f(z)=z^2-\tfrac {5}{4}$ on $[-1.8,1.8]\times [-0.8,0.8]$ ($600$ iterations). The parabolic 2-cycle $\{z_1\approx 0.207,\,z_2\approx -1.207\}$ has multiplier $(f^2)'(z_1)=-1$. \textit {Black interior}: the parabolic basin; orbits converge to $\{z_1,z_2\}$ at the logarithmic rate $(\log N)/N$. \textit {Coloured exterior}: basin of $\infty $. White circles $\bullet $: cycle points $z_1$ (right) and $z_2$ (left). Semicircular arcs show the cyclic order: $z_1\xrightarrow {f}z_2$ (upper arc) and $z_2\xrightarrow {f}z_1$ (lower arc); arc radius $|z_1-z_2|/2=\sqrt {2}/2$}{figure.2}{}}
\@writefile{toc}{\contentsline {paragraph}{Superattracting 2-cycle: $f(z)=z^2-1$ (Basilica).}{13}{section*.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Basin portrait of $f(z)=z^2-1$ (the Basilica) on $[-1.8,1.8]\times [-0.9,0.9]$ ($400$ iterations, $8$ bands). The superattracting 2-cycle $\{0,-1\}$ has multiplier $0$. \textit  {Two coloured regions}: the basin of $0$ and the basin of $-1$, graded by convergence speed. \textit  {Black}: the Julia set $J(f)$ (the Basilica), which forms the fractal boundary between the two basins and has zero Lebesgue measure. White circles $\bullet $: cycle points $0$ (right) and $-1$ (left); semicircular arcs show the cyclic order $0\xrightarrow {f}-1$ (upper) and $-1\xrightarrow {f}0$ (lower); arc radius $\genfrac  {}{}{}1{1}{2}$. Compare with Figures\nobreakspace  {}\ref  {fig:cycle_parabolic_p2} and\nobreakspace  {}\ref  {fig:cycle_parabolic_p4}: the parabolic basins are \emph  {black} (logarithmically slow convergence, undetected within budget), while the superattracting basins are \emph  {coloured} (detected immediately).}}{13}{figure.3}\protected@file@percent }
\newlabel{fig:cycle_attract_basilica}{{3}{13}{Basin portrait of $f(z)=z^2-1$ (the Basilica) on $[-1.8,1.8]\times [-0.9,0.9]$ ($400$ iterations, $8$ bands). The superattracting 2-cycle $\{0,-1\}$ has multiplier $0$. \textit {Two coloured regions}: the basin of $0$ and the basin of $-1$, graded by convergence speed. \textit {Black}: the Julia set $J(f)$ (the Basilica), which forms the fractal boundary between the two basins and has zero Lebesgue measure. White circles $\bullet $: cycle points $0$ (right) and $-1$ (left); semicircular arcs show the cyclic order $0\xrightarrow {f}-1$ (upper) and $-1\xrightarrow {f}0$ (lower); arc radius $\tfrac {1}{2}$. Compare with Figures~\ref {fig:cycle_parabolic_p2} and~\ref {fig:cycle_parabolic_p4}: the parabolic basins are \emph {black} (logarithmically slow convergence, undetected within budget), while the superattracting basins are \emph {coloured} (detected immediately)}{figure.3}{}}
