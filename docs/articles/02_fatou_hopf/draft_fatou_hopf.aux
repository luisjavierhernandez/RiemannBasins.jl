\@writefile{toc}{\contentsline {paragraph}{Birkhoff comparison.}{14}{section*.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Birkhoff partial averages $B_N=\frac  {1}{N}\DOTSB \sum@ \slimits@ _{k=0}^{N-1}\qopname  \relax o{log}f^{\#}(f^k(0))$ along the critical orbit, for $f_c(z)=z^2+c$ up to $N=15\,000$. \textit  {Blue solid}: $c=-\genfrac  {}{}{}1{3}{4}$ (parabolic fixed point, multiplier $-1$ for $f^2$). \textit  {Orange solid}: $c=-\genfrac  {}{}{}1{5}{4}$ (parabolic 2-cycle, multiplier $-1$). \textit  {Green solid}: $c=-\genfrac  {}{}{}1{1}{2}$ (attracting fixed point, Lyapunov constant $\ell \approx -0.73$). \textit  {Blue dashed}: theoretical prediction $A(\qopname  \relax o{log}N)/N$, calibrated at $N=100$ for $c=-\genfrac  {}{}{}1{3}{4}$. \textit  {Dotted line}: $B_N=0$. The parabolic averages decay logarithmically, confirming\nobreakspace  {}\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:parabolic_rate}\unskip \@@italiccorr )}}, while the attracting average converges geometrically to $\ell <0$.}}{14}{figure.4}\protected@file@percent }
\newlabel{fig:cycle_birkhoff}{{4}{14}{Birkhoff partial averages $B_N=\frac {1}{N}\sum _{k=0}^{N-1}\log \fsh (f^k(0))$ along the critical orbit, for $f_c(z)=z^2+c$ up to $N=15\,000$. \textit {Blue solid}: $c=-\tfrac {3}{4}$ (parabolic fixed point, multiplier $-1$ for $f^2$). \textit {Orange solid}: $c=-\tfrac {5}{4}$ (parabolic 2-cycle, multiplier $-1$). \textit {Green solid}: $c=-\tfrac {1}{2}$ (attracting fixed point, Lyapunov constant $\ell \approx -0.73$). \textit {Blue dashed}: theoretical prediction $A(\log N)/N$, calibrated at $N=100$ for $c=-\tfrac {3}{4}$. \textit {Dotted line}: $B_N=0$. The parabolic averages decay logarithmically, confirming~\eqref {eq:parabolic_rate}, while the attracting average converges geometrically to $\ell <0$}{figure.4}{}}
